CONFIG_IDF_TARGET="esp32p4"
# Console on UART0 (the USB-to-UART bridge port) — unaffected by the BSP's USB-OTG init.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# Board has 32MB NOR flash; the A/B OTA partition layout needs > 6MB.
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="32MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
# PSRAM / cache / perf settings the MIPI-DSI panel needs (from the Waveshare demo).
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_CACHE_L2_CACHE_256KB=y
# esp_hosted: slave = ESP32-C6 -> enables the SDIO transport (board matches defaults).
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
# MIPI-DSI display rendering modes from the working demo.
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=2
CONFIG_BSP_DISPLAY_LVGL_AVOID_TEAR=y
CONFIG_BSP_DISPLAY_LVGL_DIRECT_MODE=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPI_FLASH_SUPPORT_GD_CHIP=y
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
# LVGL fonts used by the idle screen (ui.c). Enabled here so the build is
# deterministic without a menuconfig step.
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y
# LVGL QR code widget (QR receipt screen).
CONFIG_LV_USE_QRCODE=y
# Extra Montserrat sizes for config-driven text (fontSize -> nearest font).
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_36=y
# --- append from docs/bsp-notes.md (Task 1): PSRAM mode/speed, the C6 Wi-Fi
#     transport (esp_wifi_remote / esp-hosted) options, and the MIPI-DSI display
#     options that the Waveshare demo's sdkconfig enables. ---
# IDF 5.4 -> 5.5 migration: the 5.5 bootloader grew to 0x60c0 bytes, which
# exceeds the 0x6000 (24KB) gap between BOOTLOADER_OFFSET_IN_FLASH (0x2000) and
# the default partition-table offset (0x8000). Move the partition table to
# 0xA000 so the bootloader has 0x8000 (32KB) of room. Safe: secure boot and
# flash encryption are both disabled.
CONFIG_PARTITION_TABLE_OFFSET=0xA000

# IDF 5.4 -> 5.5 migration: this board's ESP32-P4 silicon is rev v1.0, but 5.5
# defaults the minimum supported revision to v3.1 (CONFIG_ESP32P4_REV_MIN_301).
# P4 rev <3.0 and >=3.0 are MUTUALLY EXCLUSIVE ("huge hardware difference",
# per esp_hw_support Kconfig) — a v3.1-min bootloader refuses to flash/boot on
# v1.0 silicon. Unlock the pre-v3 revisions and pin the minimum to v1.0.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# IDF 5.5 / esp_hosted SDIO: the host-side SDIO transport mempool is allocated
# from DMA-capable memory. By default that's INTERNAL DMA RAM, which the MIPI-DSI
# display + LVGL buffers have already exhausted on this board -> esp_hosted
# asserts at boot ("HS_MP: mempool create failed: no mem", sdio_drv.c:255) and
# reboot-loops. The ESP32-P4 GDMA can reach PSRAM through cache, so route the
# transport buffers to DMA-capable SPIRAM (falls back to internal on failure).
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y

# SDIO data path: at the 40MHz P4 max, the C6 link inits + associates fine but
# the first sustained data traffic (DHCP/cloud poll) hits a write timeout
# ("H_SDIO_DRV: Failed to send data: 258" = ESP_ERR_TIMEOUT -> "Unrecoverable
# host sdio state" -> host self-restart loop). Drop to 20MHz for signal-integrity
# margin on this board's routing; revisit 40MHz only if throughput demands it.
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=20000
